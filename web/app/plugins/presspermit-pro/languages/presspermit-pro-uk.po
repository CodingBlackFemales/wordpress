msgstr ""
"Вимкніть посилання \"Додати дитину\", якщо користувач нефільтрований "
"(Адміністратор або має можливість pp_nested_pages_unfiltered)"

#: includes-pro/admin-load.php:488
msgid "Disable Add Child Page link unless user is unfiltered"
msgstr "Вимкнути посилання Додати дочірню сторінку, якщо користувач нефільтрований"

#: includes-pro/admin-load.php:491
msgid "Disable Insert Page Before link unless user is unfiltered"
msgstr "Вимкнути посилання Вставити сторінку перед, якщо користувач нефільтрований"

#: includes-pro/admin-load.php:494
msgid "Disable Insert Page After link unless user is unfiltered"
msgstr "Вимкнути посилання Вставити сторінку після, якщо користувач нефільтрований"

#: includes-pro/admin-load.php:497
msgid "Disable Push to Top link unless user is unfiltered"
msgstr "Вимкнути посилання Перемістити вгору, якщо користувач нефільтрований"

#: includes-pro/admin-load.php:500
msgid "Disable Push to Bottom link unless user is unfiltered"
msgstr "Вимкнути посилання Перемістити вниз, якщо користувач нефільтрований"

#: includes-pro/admin-load.php:503
msgid "Disable Clone link unless user is unfiltered"
msgstr "Вимкнути посилання Клонувати, якщо користувач нефільтрований"

