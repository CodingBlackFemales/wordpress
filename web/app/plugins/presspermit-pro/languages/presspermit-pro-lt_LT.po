msgstr ""
"Išjunkite \"Pridėti vaiką\" nuorodą, nebent vartotojas būtų nefiltruotas "
"(Administratorius arba turi pp_nested_pages_unfiltered galimybę)"

#: includes-pro/admin-load.php:488
msgid "Disable Add Child Page link unless user is unfiltered"
msgstr ""
"Išjungti \"Pridėti vaikų puslapį\" nuorodą, nebent vartotojas yra "
"nefiltruotas"

#: includes-pro/admin-load.php:491
msgid "Disable Insert Page Before link unless user is unfiltered"
msgstr ""
"Išjungti \"Įterpti puslapį prieš\" nuorodą, nebent vartotojas yra "
"nefiltruotas"

#: includes-pro/admin-load.php:494
msgid "Disable Insert Page After link unless user is unfiltered"
msgstr "Išjungti \"Įterpti puslapį po\" nuorodą, nebent vartotojas yra nefiltruotas"

#: includes-pro/admin-load.php:497
msgid "Disable Push to Top link unless user is unfiltered"
msgstr "Išjungti \"Stumti į viršų\" nuorodą, nebent vartotojas yra nefiltruotas"

