# Copy to .env to configure the test suite. The file is gitignored.
#
# Directory of real decks and documents for the opt-in corpus test. Relative
# paths resolve against the plugin root. Leave this unset and drop files into
# tests/assets/ instead — that is the default location, and also gitignored.
#
# An environment variable of the same name overrides this file:
#   CBF_SI_FIXTURE_DIR=../../../../tools/slides-to-learndash/assets composer test
CBF_SI_FIXTURE_DIR=tests/assets
