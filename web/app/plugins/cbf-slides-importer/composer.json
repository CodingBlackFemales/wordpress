{
  "name": "codingblackfemales/cbf-slides-importer",
  "description": "WordPress plugin: import Google Slides decks into LearnDash via a browser-based admin UI.",
  "homepage": "https://codingblackfemales.com",
  "type": "wordpress-plugin",
  "keywords": ["wordpress", "learndash", "google-slides", "importer"],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "google/apiclient": "^2.15",
    "phpoffice/phppresentation": "^1.1"
  },
  "require-dev": {
    "composer/installers": "^2.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "CodingBlackFemales\\SlidesImporter\\": "includes/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "google/apiclient-services": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "phpcs": [
      "phpcs . --ignore=vendor,node_modules,assets --extensions=php -s -p"
    ],
    "phpcbf": [
      "phpcbf . --ignore=vendor,node_modules,assets --extensions=php -p"
    ]
  },
  "extra": {
    "scripts-description": {
      "phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
      "phpcbf": "Fix coding standards warnings/errors automatically with PHP Code Beautifier"
    },
    "google/apiclient-services": [
      "Drive"
    ]
  }
}
