{
  "name": "codingblackfemales/cbf-slides-importer",
  "description": "WordPress plugin: import slide decks, PDFs and Word documents into LearnDash via a browser-based admin UI.",
  "homepage": "https://codingblackfemales.com",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "learndash",
    "google-slides",
    "pdf",
    "docx",
    "importer"
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.5",
    "google/apiclient": "^2.15",
    "phpoffice/phppresentation": "^1.1",
    "phpoffice/phpword": "^1.4",
    "smalot/pdfparser": "^2.12"
  },
  "require-dev": {
    "composer/installers": "^2.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "wp-coding-standards/wpcs": "^3.2",
    "codeception/codeception": "^5.3.5",
    "codeception/module-asserts": "^3.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "CodingBlackFemales\\SlidesImporter\\": "includes/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "google/apiclient-services": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "phpcs": [
      "phpcs . --ignore=vendor,node_modules,assets --extensions=php -s -p"
    ],
    "phpcbf": [
      "phpcbf . --ignore=vendor,node_modules,assets --extensions=php -p"
    ],
    "test": [
      "php -d register_argc_argv=1 vendor/bin/codecept run"
    ],
    "test:unit": [
      "php -d register_argc_argv=1 vendor/bin/codecept run Unit"
    ],
    "test:build": [
      "php -d register_argc_argv=1 vendor/bin/codecept build"
    ]
  },
  "extra": {
    "scripts-description": {
      "phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
      "phpcbf": "Fix coding standards warnings/errors automatically with PHP Code Beautifier",
      "test": "Run the full Codeception suite",
      "test:unit": "Run the Codeception unit suite (no WordPress required)",
      "test:build": "Regenerate Codeception actor classes"
    },
    "google/apiclient-services": [
      "Drive"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "CodingBlackFemales\\SlidesImporter\\Tests\\": "tests/"
    }
  }
}
